<launch>
  <arg name="load_robot_description" value="true"/>
  <arg name="robot_description" default="robot_description"/>


  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)" textfile="$(find jaka_4600_support)/urdf/jaka_zu12.urdf"/>

  <!-- The semantic description that corresponds to the URDF -->
  <param name="$(arg robot_description)_semantic" textfile="$(find jaka_moveit_config)/config/jaka.srdf" />


  <node pkg="tf2_ros" type="static_transform_publisher" name="virtual_joint_broadcaster_0" args="0 0 0 0 0 0 World base" />

  <!-- launch interactivity_tutorial -->
  <node name="benchmarkFCL" pkg="rtcc_benchmark" type="fcl_benchmark_node" respawn="false" output="screen">
    <rosparam command="load" file="$(find jaka_moveit_config)/config/kinematics.yaml" subst_value="true"/>
  </node>

</launch>
